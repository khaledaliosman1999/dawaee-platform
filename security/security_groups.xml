<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ══════════════════════════════════════════════════
         مجموعات الأمان — منصة دوائي
         ══════════════════════════════════════════════════
         
         التصميم لأنواع المستخدمين:
         
         group_dawai_patient    → Portal User   (base.group_portal)
         group_dawai_pharmacist → Internal User  (base.group_user)
         group_dawai_admin      → Internal User  (يرث الصيدلاني)

         ══════════════════════════════════════════════════ -->

    <record id="module_category_dawai" model="ir.module.category">
        <field name="name">منصة دوائي</field>
        <field name="description">إدارة وتوفير الأدوية المزمنة والنادرة</field>
        <field name="sequence">100</field>
    </record>

    <!-- ─── 1. مريض مسجل → Portal User ──────────────── -->
    <!-- المريض يدخل عبر بوابة Odoo Portal -->
    <record id="group_dawai_patient" model="res.groups">
        <field name="name">مريض مسجل</field>
        <field name="category_id" ref="module_category_dawai"/>
        <field name="comment">
            يستطيع البحث والتصفح وإنشاء وإلغاء حجوزاته الخاصة.
            نوع الحساب: Portal User.
        </field>
        <field name="implied_ids"
               eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <!-- ─── 2. مسؤول الصيدلية → Internal User ─────── -->
    <!-- الصيدلاني موظف داخلي - لا يرث group_patient حتى لا يصبح Portal -->
    <record id="group_dawai_pharmacist" model="res.groups">
        <field name="name">مسؤول الصيدلية</field>
        <field name="category_id" ref="module_category_dawai"/>
        <field name="comment">
            يدير المخزون، يستلم الشحنات، يسجل الوصفات، يصرف الأدوية.
            نوع الحساب: Internal User.
        </field>
        <field name="implied_ids"
               eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- ─── 3. مدير النظام → Internal User ──────────── -->
    <!-- يرث الصيدلاني (Internal) فقط - بدون إضافة users يدوياً -->
    <record id="group_dawai_admin" model="res.groups">
        <field name="name">مدير النظام</field>
        <field name="category_id" ref="module_category_dawai"/>
        <field name="comment">
            صلاحيات كاملة: إدارة الصيدليات، الموردين، المرضى،
            التقارير الشاملة، إدارة الصلاحيات.
            نوع الحساب: Internal User.
        </field>
        <field name="implied_ids"
               eval="[(4, ref('group_dawai_pharmacist'))]"/>
    </record>

    <!--  لضمان ان الصيدلي لا يري الا المخزون الخاص به   -->
    <record id="rule_inventory_pharmacist_only" model="ir.rule">
        <field name="name">Pharmacist Inventory Access</field>
        <field name="model_id" ref="model_dawai_inventory"/>
        <field name="domain_force">[('pharm_id', '=', user.pharmacy_id.id)]</field>
        <field name="groups" eval="[(4, ref('dawaee_platform.group_dawai_pharmacist'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!--  لضمان ان الصيدلي لا يري الا شحنات التوريد الخاص به   -->
    <record id="rule_pharmacist_own_inbounds" model="ir.rule">
        <field name="name">Pharmacist: Own Pharmacy Inbounds Only</field>

        <field name="model_id" ref="model_dawai_stock_inbound"/>

        <field name="domain_force">[('pharm_id', '=', user.pharmacy_id.id)]</field>

        <field name="groups" eval="[(4, ref('dawaee_platform.group_dawai_pharmacist'))]"/>

        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!--    المخزون للمسؤول-->
    <record id="rule_admin_all_inventory" model="ir.rule">
        <field name="name">Admin: Access All Pharmacies Inventory</field>

        <field name="model_id" ref="model_dawai_inventory"/>

        <field name="domain_force">[(1, '=', 1)]</field>

        <field name="groups" eval="[(4, ref('dawaee_platform.group_dawai_admin'))]"/>

        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <!--الحجوزات للصيادلة-->
    <record id="rule_pharmacist_own_bookings" model="ir.rule">
        <field name="name">Pharmacist: Own Pharmacy Bookings Only</field>

        <field name="model_id" ref="model_dawai_medicine_booking"/>

        <field name="domain_force">[('pharm_id', '=', user.pharmacy_id.id)]</field>

        <field name="groups" eval="[(4, ref('dawaee_platform.group_dawai_pharmacist'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!--الحجوزات للمسؤول-->
    <record id="rule_admin_all_bookings" model="ir.rule">
        <field name="name">Admin: Access All Bookings</field>

        <field name="model_id" ref="model_dawai_medicine_booking"/>

        <field name="domain_force">[(1, '=', 1)]</field>

        <field name="groups" eval="[(4, ref('dawaee_platform.group_dawai_admin'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
    <!--    عمليات الصرف للصيدلية-->
    <record id="rule_pharmacist_own_dispense" model="ir.rule">
        <field name="name">Pharmacist: Own Pharmacy Dispense Operations Only</field>

        <field name="model_id" ref="model_dawai_dispensing_transaction"/>

        <field name="domain_force">[('pharm_id', '=', user.pharmacy_id.id)]</field>

        <field name="groups" eval="[(4, ref('dawaee_platform.group_dawai_pharmacist'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    <!--    عمليات الصرف للمسؤول-->
    <record id="rule_admin_all_dispense" model="ir.rule">
        <field name="name">Admin: Access All Dispense Operations</field>

        <field name="model_id" ref="model_dawai_dispensing_transaction"/>

        <field name="domain_force">[(1, '=', 1)]</field>

        <field name="groups" eval="[(4, ref('dawaee_platform.group_dawai_admin'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <record id="rule_report_wizard_access" model="ir.rule">
        <field name="name">Access Report Wizard</field>
        <field name="model_id" ref="model_dispensing_report_wizard"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups"
               eval="[(4, ref('dawaee_platform.group_dawai_admin')), (4, ref('dawaee_platform.group_dawai_pharmacist'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

</odoo>
