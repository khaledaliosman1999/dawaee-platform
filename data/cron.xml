<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ══════════════════════════════════════════════════
         Cron Job: انتهاء الحجوزات تلقائياً بعد 24 ساعة
         يُشغَّل كل ساعة — يُحوّل الحجوزات المنتهية لـ expired
         ══════════════════════════════════════════════════ -->
    <record id="cron_dawai_expire_bookings" model="ir.cron">
        <field name="name">دوائي: انتهاء صلاحية الحجوزات (24 ساعة)</field>
        <field name="model_id" ref="model_dawai_medicine_booking"/>
        <field name="state">code</field>
        <field name="code">
            model._cron_expire_bookings()
        </field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
