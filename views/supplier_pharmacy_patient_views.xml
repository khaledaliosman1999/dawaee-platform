<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ══════════════════════════════════════════════
     SUPPLIER
══════════════════════════════════════════════ -->
    <record id="view_dawai_supplier_list" model="ir.ui.view">
        <field name="name">dawai.supplier.list</field>
        <field name="model">dawai.supplier</field>
        <field name="arch" type="xml">
            <list string="الموردون" decoration-muted="active == False">
                <field name="supplier_name" string="الاسم"/>
                <field name="supplier_type" string="النوع" widget="badge"
                       decoration-info="supplier_type == 'government'"
                       decoration-warning="supplier_type == 'private'"
                       decoration-success="supplier_type == 'international'"/>
                <field name="contact_name"  string="جهة الاتصال"/>
                <field name="phone" string="الهاتف" widget="phone"/>
                <field name="email" string="البريد" widget="email"/>
                <field name="inbound_count" string="عدد الشحنات"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_dawai_supplier_form" model="ir.ui.view">
        <field name="name">dawai.supplier.form</field>
        <field name="model">dawai.supplier</field>
        <field name="arch" type="xml">
            <form string="بيانات المورد">
                <sheet>
                    <widget name="web_ribbon" title="مؤرشف" bg_color="text-bg-danger" invisible="active"/>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_inbound" type="object"
                                class="oe_stat_button" icon="fa-truck">
                            <field name="inbound_count" string="الشحنات" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="supplier_name" placeholder="اسم الشركة أو الجهة..."/></h1>
                    </div>
                    <group>
                        <group string="بيانات التصنيف">
                            <field name="supplier_type" string="نوع المورد"/>
                            <field name="active" string="نشط" widget="boolean_toggle"/>
                        </group>
                        <group string="بيانات التواصل">
                            <field name="contact_name" string="الشخص المسؤول"/>
                            <field name="phone" string="الهاتف" widget="phone"/>
                            <field name="email" string="البريد الإلكتروني" widget="email"/>
                        </group>
                    </group>
                    <group string="العنوان">
                        <field name="address" string="العنوان الكامل" nolabel="1"
                               placeholder="المدينة، الشارع، المبنى..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dawai_supplier_search" model="ir.ui.view">
        <field name="name">dawai.supplier.search</field>
        <field name="model">dawai.supplier</field>
        <field name="arch" type="xml">
            <search string="بحث في الموردين">
                <field name="supplier_name" string="الاسم"/>
                <field name="contact_name"  string="جهة الاتصال"/>
                <separator/>
                <filter name="gov"  string="حكومي"
                        domain="[('supplier_type','=','government')]"/>
                <filter name="priv" string="خاص"
                        domain="[('supplier_type','=','private')]"/>
                <filter name="intl" string="دولي"
                        domain="[('supplier_type','=','international')]"/>
                <separator/>
                <filter name="archived" string="مؤرشف"
                        domain="[('active','=',False)]"/>
                <group expand="0" string="تجميع حسب">
                    <filter name="group_supplier_type" string="نوع المورد"
                            context="{'group_by':'supplier_type'}"/>
                </group>

                <searchpanel>
                    <field name="supplier_type" string="نوع المورد" icon="fa-building" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_dawai_supplier" model="ir.actions.act_window">
        <field name="name">الموردون</field>
        <field name="res_model">dawai.supplier</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dawai_supplier_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">أضف أول مورد لشبكة دوائي</p>
            <p>قم بإضافة شركات الأدوية والإمدادات الطبية لتتبع مصادر الشحنات بسهولة.</p>
        </field>
    </record>

<!-- ══════════════════════════════════════════════
     PHARMACY
══════════════════════════════════════════════ -->
    <record id="view_dawai_pharmacy_list" model="ir.ui.view">
        <field name="name">dawai.pharmacy.list</field>
        <field name="model">dawai.pharmacy</field>
        <field name="arch" type="xml">
            <list string="الصيدليات" decoration-muted="active == False">
                <field name="pharm_name"      string="الصيدلية"/>
                <field name="license_no"      string="رقم الترخيص"/>
                <field name="pharmacy_phone" string="الهاتف" widget="phone"/>
                <field name="user_id" string="المسؤول" widget="many2one_avatar"/>
                <field name="inventory_count" string="الأدوية"/>
                <field name="booking_count"   string="حجوزات نشطة"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_dawai_pharmacy_form" model="ir.ui.view">
        <field name="name">dawai.pharmacy.form</field>
        <field name="model">dawai.pharmacy</field>
        <field name="arch" type="xml">
            <form string="بيانات الصيدلية">
                <sheet>
                    <widget name="web_ribbon" title="مؤرشفة" bg_color="text-bg-danger" invisible="active"/>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_inventory" type="object"
                                class="oe_stat_button" icon="fa-cubes">
                            <field name="inventory_count" string="الأدوية" widget="statinfo"/>
                        </button>
                        <button name="action_view_bookings" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="booking_count" string="حجوزات نشطة" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="pharm_name" placeholder="اسم الصيدلية..."/></h1>
                    </div>
                    <group>
                        <group string="بيانات الترخيص">
                            <field name="license_no" string="رقم الترخيص"/>
                            <field name="user_id" string="حساب المسؤول" widget="many2one_avatar"/>
                            <field name="active" string="نشطة في النظام" widget="boolean_toggle"/>
                        </group>
                        <group string="بيانات التواصل">
                            <field name="pharmacy_phone" string="رقم التواصل" widget="phone"/>
                            <field name="map_url" string="رابط الخريطة" widget="url" text="فتح في Google Maps"/>
                        </group>
                    </group>
                    <group string="العنوان">
                        <field name="address" string="العنوان الكامل" nolabel="1"
                               placeholder="المدينة، الحي، الشارع، أقرب معلم..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dawai_pharmacy_search" model="ir.ui.view">
        <field name="name">dawai.pharmacy.search</field>
        <field name="model">dawai.pharmacy</field>
        <field name="arch" type="xml">
            <search string="بحث في الصيدليات">
                <field name="pharm_name"  string="الصيدلية"/>
                <field name="license_no"  string="رقم الترخيص"/>
                <field name="user_id" string="حساب المسؤول"/>
                <separator/>
                <filter name="active_only" string="نشطة فقط"
                        domain="[('active','=',True)]"/>
                <filter name="archived"    string="مؤرشفة"
                        domain="[('active','=',False)]"/>
                <group expand="0" string="تجميع حسب">
                    <filter name="group_user" string="حساب المسؤول"
                            context="{'group_by':'user_id'}"/>
                    <filter name="group_active" string="الحالة"
                            context="{'group_by':'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dawai_pharmacy" model="ir.actions.act_window">
        <field name="name">الصيدليات</field>
        <field name="res_model">dawai.pharmacy</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dawai_pharmacy_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">أضف أول صيدلية إلى شبكة دوائي</p>
            <p>قم بتسجيل بيانات الصيدليات، ربطها بحسابات مديريها، وتتبع مخزونها وحجوزاتها من مكان واحد.</p>
        </field>
    </record>
<!-- ══════════════════════════════════════════════
     PATIENT
══════════════════════════════════════════════ -->
    <record id="view_dawai_patient_list" model="ir.ui.view">
        <field name="name">dawai.patient.list</field>
        <field name="model">dawai.patient</field>
        <field name="arch" type="xml">
            <list string="المرضى" decoration-muted="active == False">
                <field name="pat_name"             string="الاسم الكامل"/>
                <field name="national_id" string="الرقم الوطني"/>
                <field name="disease_type" string="المرض" widget="badge"
                       decoration-info="disease_type == 'diabetes'"
                       decoration-danger="disease_type == 'heart'"
                       decoration-warning="disease_type == 'pressure'"
                       decoration-success="disease_type == 'asthma'"/>
                <field name="contact_info" string="الهاتف" widget="phone"/>
                <field name="email" string="البريد" widget="email"/>
                <field name="booking_count" string="الحجوزات"/>
                <field name="active_booking_count" string="النشطة"/>
                <field name="user_id" string="حساب المنصة" widget="many2one_avatar"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_dawai_patient_form" model="ir.ui.view">
        <field name="name">dawai.patient.form</field>
        <field name="model">dawai.patient</field>
        <field name="arch" type="xml">
            <form string="بيانات المريض">
                <sheet>
                    <widget name="web_ribbon" title="مؤرشف" bg_color="text-bg-danger" invisible="active"/>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bookings" type="object"
                                class="oe_stat_button" icon="fa-calendar-check-o">
                            <div class="o_stat_info">
                                <field name="booking_count" class="o_stat_value"/>
                                <span class="o_stat_text">حجوزات</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="pat_name" placeholder="الاسم الكامل للمريض..."/></h1>
                    </div>
                    <group>
                        <group string="البيانات الشخصية">
                            <field name="national_id"  string="الرقم الوطني"/>
                            <field name="disease_type" string="نوع المرض"/>
                            <field name="active" string="حساب نشط" widget="boolean_toggle"/>
                        </group>
                        <group string="بيانات التواصل">
                            <field name="contact_info" string="رقم الهاتف" widget="phone"/>
                            <field name="email" string="البريد الإلكتروني" widget="email"/>
                            <field name="user_id" string="حساب المنصة (Portal)"
                                   widget="many2one_avatar" options="{'no_create': True}"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dawai_patient_search" model="ir.ui.view">
        <field name="name">dawai.patient.search</field>
        <field name="model">dawai.patient</field>
        <field name="arch" type="xml">
            <search string="بحث في المرضى">
                <field name="pat_name"    string="الاسم"/>
                <field name="national_id" string="الرقم الوطني"/>
                <field name="email"       string="البريد"/>
                <separator/>
                <filter name="no_account" string="بدون حساب منصة"
                        domain="[('user_id','=',False)]"/>
                <filter name="has_account" string="لديه حساب"
                        domain="[('user_id','!=',False)]"/>
                <separator/>
                <filter name="archived" string="مؤرشف"
                        domain="[('active','=',False)]"/>
                <group expand="0" string="تجميع حسب">
                    <filter name="group_disease" string="نوع المرض"
                            context="{'group_by':'disease_type'}"/>
                </group>

                <searchpanel>
                    <field name="disease_type" string="تصنيف الأمراض" icon="fa-heartbeat" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_dawai_patient" model="ir.actions.act_window">
        <field name="name">المرضى</field>
        <field name="res_model">dawai.patient</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dawai_patient_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">أضف أول مريض في منصة دوائي</p>
            <p>يتم تسجيل المرضى هنا إما يدوياً بواسطة الإدارة، أو تلقائياً عند قيامهم بالتسجيل والحجز عبر المنصة.</p>
        </field>
    </record>

    <record id="view_users_form_inherit_dawai" model="ir.ui.view">
        <field name="name">res.users.form.inherit.dawai</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="بيانات منصة دوائي" name="dawai_info">
                    <group>
                        <field name="pharmacy_id" options="{'no_create': True}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
