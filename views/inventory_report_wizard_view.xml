<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inventory_report_wizard_form" model="ir.ui.view">
        <field name="name">inventory.report.wizard.form</field>
        <field name="model">inventory.report.wizard</field>
        <field name="arch" type="xml">
            <form string="تقرير المخزون الحالي">
                <group>
                    <field name="pharmacy_id" readonly="is_readonly_pharmacy"/>
                    <field name="is_readonly_pharmacy" invisible="1"/>
                    <field name="low_stock_only"/>
                    <field name="order_type" widget="radio"/>
                </group>
                <footer>
                    <button name="action_print_report" type="object"
                            string="طباعة التقرير" class="btn-primary"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_inventory_report_wizard" model="ir.actions.act_window">
        <field name="name">تقرير المخزون الحالي</field>
        <field name="res_model">inventory.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>