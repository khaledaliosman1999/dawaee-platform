<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="pharmacist_premium_styles" inherit_id="website.layout" name="Premium App Styles">
        <xpath expr="//head" position="inside">
            <style>
                body { background-color: #F8FAFC !important; }

                /* الترويسات الفخمة */
                .premium-header-main { background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); }
                .premium-header-teal { background: linear-gradient(135deg, #0F766E 0%, #06B6D4 100%); }
                .premium-header-emerald { background: linear-gradient(135deg, #065F46 0%, #10B981 100%); }
                .premium-header-blue { background: linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%); }

                .premium-header-base {
                color: white;
                border-bottom-left-radius: 2.5rem;
                border-bottom-right-radius: 2.5rem;
                box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
                padding: 3rem 1.5rem 5rem 1.5rem;
                margin-bottom: -3rem;
                }

                /* البطاقات العائمة */
                .premium-card {
                background: #FFFFFF;
                border-radius: 1.5rem;
                border: 1px solid rgba(0,0,0,0.03);
                box-shadow: 0 10px 30px -5px rgba(0,0,0,0.05);
                transition: transform 0.2s ease, box-shadow 0.2s ease;
                }
                .premium-card:active { transform: translateY(3px); box-shadow: 0 5px 15px -5px rgba(0,0,0,0.03); }

                /* أيقونات البطاقات */
                .icon-box {
                width: 55px; height: 55px;
                border-radius: 1.25rem;
                display: flex; align-items: center; justify-content: center;
                font-size: 1.5rem; margin: 0 auto 1rem auto;
                }

                /* حقول الإدخال العصرية */
                .premium-input {
                background-color: #F1F5F9; border: 2px solid transparent;
                border-radius: 1rem; padding: 1rem 1.25rem;
                font-weight: 600; color: #1E293B; transition: all 0.3s ease;
                }
                .premium-input:focus {
                background-color: #FFFFFF; border-color: #3B82F6;
                box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1); outline: none;
                }

                /* الأزرار الرئيسية */
                .btn-premium {
                background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
                color: white; border: none; border-radius: 1rem;
                padding: 1.25rem; font-weight: 700; font-size: 1.1rem;
                box-shadow: 0 10px 25px rgba(37, 99, 235, 0.3); transition: all 0.2s;
                }
                .btn-premium:hover { opacity: 0.95; transform: scale(0.98); color: white; }
                .btn-premium-success { background: linear-gradient(135deg, #10B981 0%, #059669 100%); box-shadow: 0 10px
                25px rgba(16, 185, 129, 0.3); }
            </style>
        </xpath>
    </template>

    <!-- ========================================== -->
    <!-- 2. لوحة التحكم الرئيسية (Dashboard) معدلة -->
    <!-- ========================================== -->
    <template id="portal_pharmacist_dashboard" name="لوحة الصيدلي">
        <t t-call="website.layout">
            <div class="pb-5 min-vh-100" style="background-color: #F8FAFC;">
                <div class="premium-header-base premium-header-main text-center">
                    <span class="badge bg-white bg-opacity-10 rounded-pill px-3 py-2 mb-3 fw-light text-white-50 border border-light border-opacity-10">
                        <i class="fa fa-shield me-1"></i>
                        الإدارة الشاملة للصيدلية
                    </span>
                    <h2 class="fw-bolder mb-1 tracking-wide">
                        <t t-esc="pharmacy_name"/>
                    </h2>
                    <p class="text-white-50 small mb-0">إدارة المخزون والحجوزات</p>
                </div>

                <div class="container position-relative" style="max-width: 600px; z-index: 10;">

                    <!-- قسم: إدارة المخزون -->
                    <h6 class="fw-bolder text-secondary mb-3 px-2 mt-2">إدارة المخزون</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <a href="/my/pharmacy/inventory/inbound" class="text-decoration-none">
                                <div class="premium-card text-center p-4 h-100 border-0">
                                    <div class="icon-box shadow-sm" style="background: #ECFDF5; color: #059669;">
                                        <i class="fa fa-truck"></i>
                                    </div>
                                    <h6 class="fw-bold text-dark mb-0 fs-6">استلام شحنات</h6>
                                </div>
                            </a>
                        </div>
                        <div class="col-6">
                            <a href="/my/pharmacy/inventory/current" class="text-decoration-none">
                                <div class="premium-card text-center p-4 h-100 border-0">
                                    <div class="icon-box shadow-sm" style="background: #ECFEFF; color: #0891B2;">
                                        <i class="fa fa-cubes"></i>
                                    </div>
                                    <h6 class="fw-bold text-dark mb-0 fs-6">المخزون الحالي</h6>
                                </div>
                            </a>
                        </div>
                    </div>

                    <!-- قسم: عمليات المنصة -->
                    <h6 class="fw-bolder text-secondary mb-3 px-2">عمليات المنصة</h6>
                    <div class="row g-3 mb-5">
                        <div class="col-6">
                            <!-- تم إضافة الرابط الحقيقي لسجل الصرف -->
                            <a href="/my/pharmacy/history" class="text-decoration-none">
                                <div class="premium-card text-center p-4 h-100 border-0">
                                    <div class="icon-box shadow-sm" style="background: #FEF2F2; color: #EF4444;">
                                        <i class="fa fa-history"></i>
                                    </div>
                                    <h6 class="fw-bold text-dark mb-0 fs-6">سجل الصرف</h6>
                                </div>
                            </a>
                        </div>
                        <div class="col-6">
                            <!-- تم تجهيز رابط الوصفات الطبية للخطوة القادمة -->
                            <a href="/my/pharmacy/prescriptions" class="text-decoration-none">
                                <div class="premium-card text-center p-4 h-100 border-0">
                                    <div class="icon-box shadow-sm" style="background: #FFFBEB; color: #F59E0B;">
                                        <i class="fa fa-file-text-o"></i>
                                    </div>
                                    <h6 class="fw-bold text-dark mb-0 fs-6">الوصفات الطبية</h6>
                                </div>
                            </a>
                        </div>
                    </div>

                    <!-- قسم: الحجوزات النشطة -->
                    <div class="d-flex justify-content-between align-items-center mb-3 px-2">
                        <h5 class="fw-bolder text-secondary mb-0">حجوزات بانتظار الصرف</h5>
                        <span class="badge bg-primary rounded-pill px-3 py-2 shadow-sm">
                            <t t-esc="len(bookings)"/>
                            طلبات
                        </span>
                    </div>

                    <t t-foreach="bookings" t-as="book">
                        <div class="premium-card mb-3 p-1" style="border-right: 4px solid #3B82F6;">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="fw-bolder text-dark mb-0 tracking-wide">
                                        <t t-esc="book.booking_code"/>
                                    </h5>
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1 rounded-pill">
                                        عاجل
                                    </span>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-6 border-end">
                                        <small class="text-muted d-block mb-1">المريض</small>
                                        <span class="fw-bold text-dark fs-6">
                                            <t t-esc="book.pat_id.pat_name"/>
                                        </span>
                                    </div>
                                    <div class="col-6 ps-3">
                                        <small class="text-muted d-block mb-1">الدواء</small>
                                        <span class="fw-bold text-primary fs-6">
                                            <t t-esc="book.med_id.med_name"/>
                                            (x<t t-esc="book.qty_booked"/>)
                                        </span>
                                    </div>
                                </div>
                                <a t-attf-href="/my/pharmacy/dispense/#{book.id}"
                                   class="btn btn-light w-100 rounded-pill fw-bold text-primary border shadow-sm py-2">
                                    التفاصيل وصرف الدواء
                                    <i class="fa fa-arrow-left ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </t>

                    <t t-if="not bookings">
                        <div class="premium-card text-center p-5 mt-4 border-dashed">
                            <div class="icon-box mx-auto mb-3 opacity-50"
                                 style="background: transparent; color: #10B981;">
                                <i class="fa fa-check-circle fa-3x"></i>
                            </div>
                            <h5 class="fw-bolder text-dark">كل شيء محدث!</h5>
                            <p class="text-muted mb-0">لا توجد طلبات حجز معلقة حالياً.</p>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>
    <template id="portal_inventory_inbound" name="تسجيل الوارد">
        <t t-call="website.layout">
            <div class="pb-5 min-vh-100" style="background-color: #F8FAFC;">
                <div class="premium-header-base premium-header-emerald d-flex justify-content-between align-items-center mb-5 pb-5">
                    <div>
                        <span class="badge bg-white bg-opacity-25 rounded-pill px-3 py-1 mb-2 fw-light border border-light border-opacity-25">
                            استلام شحنة
                        </span>
                        <h4 class="fw-bolder mb-0">إضافة مخزون</h4>
                    </div>
                    <a href="/my/pharmacy" class="btn btn-light bg-opacity-25 border-0 text-white rounded-pill px-4">
                        رجوع
                    </a>
                </div>

                <div class="container position-relative" style="max-width: 600px; margin-top: -4rem; z-index: 10;">
                    <t t-if="success">
                        <div class="alert bg-white border-start border-success border-4 shadow-sm rounded-4 d-flex align-items-center mb-4 p-4">
                            <div class="icon-box shadow-sm m-0 me-3"
                                 style="background:#ECFDF5; color:#059669; width:45px; height:45px;">
                                <i class="fa fa-check"></i>
                            </div>
                            <div>
                                <h6 class="fw-bolder text-dark mb-1">تمت الإضافة بنجاح!</h6>
                            </div>
                        </div>
                    </t>

                    <div class="premium-card p-4 mb-4">
                        <form action="/my/pharmacy/inventory/inbound" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="mb-4">
                                <label class="form-label fw-bold text-secondary small ms-1">اختر الدواء</label>
                                <select name="med_id" class="form-select premium-input" required="1">
                                    <option value="" disabled="1" selected="1">-- القائمة --</option>
                                    <t t-foreach="medicines" t-as="med">
                                        <option t-att-value="med.id">
                                            <t t-esc="med.med_name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                            <div class="row g-3 mb-5">
                                <div class="col-6">
                                    <label class="form-label fw-bold text-secondary small ms-1">الكمية الواردة</label>
                                    <input type="number" name="qty_received"
                                           class="form-control premium-input text-center" min="1" placeholder="0"
                                           required="1"/>
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-bold text-secondary small ms-1">سعر البيع</label>
                                    <input type="number" step="0.01" name="unit_price"
                                           class="form-control premium-input text-center" min="1" placeholder="SDG"
                                           required="1"/>
                                </div>
                            </div>
                            <button type="submit" class="btn-premium btn-premium-success w-100">
                                حفظ في الرصيد
                                <i class="fa fa-download ms-1"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_inventory_current" name="المخزون الحالي">
        <t t-call="website.layout">
            <div class="pb-5 min-vh-100" style="background-color: #F8FAFC;">
                <div class="premium-header-base premium-header-teal d-flex justify-content-between align-items-center mb-5 pb-5">
                    <div>
                        <span class="badge bg-white bg-opacity-25 rounded-pill px-3 py-1 mb-2 fw-light border border-light border-opacity-25">
                            جرد وإحصائيات
                        </span>
                        <h4 class="fw-bolder mb-0 text-white">المخزون الحالي</h4>
                    </div>
                    <a href="/my/pharmacy"
                       class="btn btn-light bg-opacity-25 border-0 text-white rounded-pill px-4 shadow-sm">رجوع
                    </a>
                </div>

                <div class="container position-relative" style="max-width: 600px; margin-top: -4rem; z-index: 10;">
                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <div class="premium-card p-3 text-center h-100">
                                <h2 class="fw-bolder text-dark mb-0">
                                    <t t-esc="len(inventory_items)"/>
                                </h2>
                                <small class="text-muted fw-bold">صنف دواء مسجل</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="premium-card p-3 text-center h-100">
                                <h2 class="fw-bolder text-primary mb-0">
                                    <t t-esc="total_qty"/>
                                </h2>
                                <small class="text-muted fw-bold">إجمالي العبوات</small>
                            </div>
                        </div>
                    </div>

                    <h6 class="fw-bolder text-secondary mb-3 px-2 mt-4">تفاصيل الأصناف</h6>
                    <t t-foreach="inventory_items" t-as="item">
                        <div class="premium-card mb-3">
                            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box me-3 m-0 shadow-sm"
                                         style="background: #F1F5F9; color: #64748B; width: 45px; height: 45px; font-size: 1.2rem;">
                                        <i class="fa fa-medkit"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bolder text-dark mb-1">
                                            <t t-esc="item.med_id.med_name"/>
                                        </h6>
                                        <small class="text-muted fw-bold">
                                            <t t-esc="item.unit_price"/>
                                            SDG
                                        </small>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <t t-if="item.qty_available &gt; 10">
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-2 fs-6">
                                            <t t-esc="item.qty_available"/>
                                            عبوة
                                        </span>
                                    </t>
                                    <t t-elif="item.qty_available &gt; 0">
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-50 rounded-pill px-3 py-2 fs-6">
                                            <t t-esc="item.qty_available"/>
                                            عبوة
                                        </span>
                                    </t>
                                    <t t-else="">
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-3 py-2 fs-6">
                                            نفد الرصيد
                                        </span>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_dispense_form" name="تأكيد الصرف للحجز">
        <t t-call="website.layout">
            <div class="pb-5 min-vh-100" style="background-color: #F8FAFC;">
                <div class="premium-header-base premium-header-blue d-flex justify-content-between align-items-center mb-5 pb-5">
                    <h4 class="fw-bolder mb-0 text-white">إتمام صرف الحجز</h4>
                    <a href="/my/pharmacy" class="btn btn-light bg-opacity-25 border-0 text-white rounded-pill px-4">
                        إلغاء
                    </a>
                </div>

                <div class="container position-relative" style="max-width: 600px; margin-top: -5rem; z-index: 10;">
                    <div class="premium-card p-4 mb-4">
                        <div class="text-center mb-4">
                            <p class="text-muted fw-bold mb-1">رمز الحجز</p>
                            <h1 class="fw-bolder text-dark tracking-wide mb-0">
                                <t t-esc="booking.booking_code"/>
                            </h1>
                        </div>

                        <div class="bg-light rounded-4 p-4 mb-4">
                            <div class="d-flex justify-content-between mb-3">
                                <span class="text-muted fw-bold">المريض</span>
                                <span class="text-dark fw-bold">
                                    <t t-esc="booking.pat_id.pat_name"/>
                                </span>
                            </div>
                            <div class="d-flex justify-content-between mb-3">
                                <span class="text-muted fw-bold">الدواء</span>
                                <span class="text-primary fw-bold">
                                    <t t-esc="booking.med_id.med_name"/>
                                    (x<t t-esc="booking.qty_booked"/>)
                                </span>
                            </div>
                            <hr class="text-muted opacity-25 my-3"/>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted fw-bold">الإجمالي المطلوب</span>
                                <h4 class="text-dark fw-bolder mb-0">
                                    <t t-esc="booking.total_price"/>
                                    <span class="fs-6 text-muted">SDG</span>
                                </h4>
                            </div>
                        </div>

                        <form t-attf-action="/my/pharmacy/dispense/#{booking.id}" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <t t-if="booking.med_id.requires_prescription">
                                <div class="p-4 mb-4"
                                     style="background-color: #FFFBEB; border: 1px solid #FEF3C7; border-radius: 1.25rem;">
                                    <h6 class="fw-bolder text-warning-emphasis mb-3">
                                        <i class="fa fa-exclamation-circle me-1"></i>
                                        إدخال بيانات الروشتة
                                    </h6>
                                    <input type="text" name="doctor_name"
                                           class="form-control premium-input bg-white mb-3"
                                           placeholder="اسم الطبيب المعالج" required="1"/>
                                    <input type="number" name="allowed_qty" class="form-control premium-input bg-white"
                                           placeholder="الكمية المسموحة" required="1"/>
                                </div>
                            </t>
                            <button type="submit" class="btn-premium w-100">تأكيد وصرف الدواء
                                <i class="fa fa-check-circle ms-1"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_pharmacist_error" name="خطأ في الصلاحيات">
        <t t-call="website.layout">
            <div class="min-vh-100 d-flex align-items-center justify-content-center" style="background-color: #F8FAFC;">
                <div class="container text-center" style="max-width: 450px;">
                    <div class="premium-card p-5">
                        <div class="icon-box mb-4 mx-auto"
                             style="background: #FEF2F2; color: #EF4444; width: 80px; height: 80px; font-size: 2.5rem;">
                            <i class="fa fa-lock"></i>
                        </div>
                        <h4 class="fw-bolder text-dark mb-3">وصول غير مصرح</h4>
                        <p class="text-muted mb-4 lh-lg">
                            <t t-esc="message"/>
                        </p>
                        <a href="/dawai/search"
                           class="btn btn-light w-100 rounded-pill fw-bold text-dark border shadow-sm py-3">العودة
                            للرئيسية
                        </a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ========================================== -->
    <!-- 7. شاشة سجل الصرف (Red/Rose Theme) -->
    <!-- ========================================== -->
    <template id="portal_dispense_history" name="سجل الصرف">
        <t t-call="website.layout">
            <div class="pb-5 min-vh-100" style="background-color: #F8FAFC;">
                <div class="premium-header-base d-flex justify-content-between align-items-center mb-5 pb-5"
                     style="background: linear-gradient(135deg, #BE123C 0%, #E11D48 100%);">
                    <div>
                        <span class="badge bg-white bg-opacity-25 rounded-pill px-3 py-1 mb-2 fw-light border border-light border-opacity-25">
                            تاريخ العمليات
                        </span>
                        <h4 class="fw-bolder mb-0 text-white">سجل الصرف</h4>
                    </div>
                    <a href="/my/pharmacy"
                       class="btn btn-light bg-opacity-25 border-0 text-white rounded-pill px-4 shadow-sm">رجوع
                    </a>
                </div>

                <div class="container position-relative" style="max-width: 600px; margin-top: -4rem; z-index: 10;">
                    <t t-foreach="history_bookings" t-as="record">
                        <div class="premium-card mb-3 p-3 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <div class="icon-box me-3 m-0 shadow-sm"
                                     style="background: #FEF2F2; color: #E11D48; width: 45px; height: 45px; font-size: 1.1rem;">
                                    <i class="fa fa-exchange"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bolder text-dark mb-1">
                                        <t t-esc="record.booking_code"/>
                                    </h6>
                                    <small class="text-muted">
                                        <t t-esc="record.med_id.med_name"/>
                                        -
                                        <t t-esc="record.pat_id.pat_name"/>
                                    </small>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-light text-dark border rounded-pill px-2 py-1 mb-1 d-block">
                                    <t t-esc="record.create_date.strftime('%Y-%m-%d')"/>
                                </span>
                                <span class="fw-bold text-success small">
                                    <t t-esc="record.total_price"/>
                                    SDG
                                </span>
                            </div>
                        </div>
                    </t>

                    <t t-if="not history_bookings">
                        <div class="premium-card text-center p-5 mt-4"
                             style="border: 2px dashed #E2E8F0; box-shadow: none;">
                            <div class="icon-box mx-auto mb-3 opacity-50"
                                 style="background: transparent; color: #94A3B8;">
                                <i class="fa fa-history fa-3x"></i>
                            </div>
                            <h5 class="fw-bolder text-dark">لا يوجد سجل</h5>
                            <p class="text-muted mb-0">لم تقم بصرف أي حجوزات حتى الآن.</p>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_prescriptions_list" name="أرشيف الوصفات">
        <t t-call="website.layout">
            <div class="pb-5 min-vh-100" style="background-color: #F8FAFC;">
                <div class="premium-header-base d-flex justify-content-between align-items-center mb-5 pb-5"
                     style="background: linear-gradient(135deg, #D97706 0%, #F59E0B 100%);">
                    <div>
                        <span class="badge bg-white bg-opacity-25 rounded-pill px-3 py-1 mb-2 fw-light border border-light border-opacity-25">
                            أرشيف الأدوية المقيدة
                        </span>
                        <h4 class="fw-bolder mb-0 text-white">الوصفات الطبية</h4>
                    </div>
                    <a href="/my/pharmacy"
                       class="btn btn-light bg-opacity-25 border-0 text-white rounded-pill px-4 shadow-sm">رجوع
                    </a>
                </div>

                <div class="container position-relative" style="max-width: 600px; margin-top: -4rem; z-index: 10;">

                    <t t-foreach="prescriptions" t-as="record">
                        <div class="premium-card mb-3 p-3 border-start border-warning border-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box me-3 m-0 shadow-sm"
                                         style="background: #FFFBEB; color: #F59E0B; width: 45px; height: 45px; font-size: 1.1rem;">
                                        <i class="fa fa-file-text-o"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bolder text-dark mb-1">
                                            <t t-esc="record.booking_code"/>
                                        </h6>
                                        <small class="text-muted">
                                            <i class="fa fa-user me-1"></i>
                                            <t t-esc="record.pat_id.pat_name"/>
                                        </small>
                                    </div>
                                </div>
                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-50 rounded-pill px-2 py-1">
                                    <i class="fa fa-lock me-1"></i>
                                    مقيدة
                                </span>
                            </div>
                            <div class="bg-light rounded-3 p-2 text-center border">
                                <small class="text-secondary fw-bold">الدواء:</small>
                                <span class="text-primary fw-bold ms-1">
                                    <t t-esc="record.med_id.med_name"/>
                                    (الكمية:<t t-esc="record.qty_booked"/>)
                                </span>
                            </div>
                        </div>
                    </t>

                    <t t-if="not prescriptions">
                        <div class="premium-card text-center p-5 mt-4"
                             style="border: 2px dashed #E2E8F0; box-shadow: none;">
                            <div class="icon-box mx-auto mb-3 opacity-50"
                                 style="background: transparent; color: #94A3B8;">
                                <i class="fa fa-folder-open-o fa-3x"></i>
                            </div>
                            <h5 class="fw-bolder text-dark">لا توجد وصفات</h5>
                            <p class="text-muted mb-0">لم يتم تسجيل أي أدوية تتطلب وصفة طبية حتى الآن في هذه الصيدلية.
                            </p>
                        </div>
                    </t>

                </div>
            </div>
        </t>
    </template>
</odoo>