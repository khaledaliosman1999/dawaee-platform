<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medicine_demand_wizard_form" model="ir.ui.view">
        <field name="name">medicine.demand.report.wizard.form</field>
        <field name="model">medicine.demand.report.wizard</field>
        <field name="arch" type="xml">
            <form string="تقرير طلب الأدوية">
                <group>
                    <field name="order_type" widget="radio"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="pharmacy_id" readonly="is_readonly_pharmacy"/>
                    <field name="is_readonly_pharmacy" invisible="1"/>
                    <field name="limit"/>
                </group>
                <footer>
                    <button name="action_print_report" type="object"
                            string="طباعة التقرير" class="btn-primary"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_medicine_demand_wizard" model="ir.actions.act_window">
        <field name="name">تقرير طلب الأدوية (الأكثر / الأقل)</field>
        <field name="res_model">medicine.demand.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>