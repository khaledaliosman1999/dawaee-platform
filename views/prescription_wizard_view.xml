<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_prescription_report_wizard_form" model="ir.ui.view">
        <field name="name">prescription.report.wizard.form</field>
        <field name="model">prescription.report.wizard</field>
        <field name="arch" type="xml">
            <form string="تقرير الوصفات الطبية">
                <group>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="low_remaining_only"/>
                    <field name="valid_only"/>
                    <field name="order_type" widget="radio"/>
                </group>
                <footer>
                    <button name="action_print_report" type="object"
                            string="طباعة التقرير" class="btn-primary"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_prescription_report_wizard" model="ir.actions.act_window">
        <field name="name">تقرير الوصفات الطبية</field>
        <field name="res_model">prescription.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>